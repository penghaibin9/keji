# 三大接口启用后放到服务器私有环境变量；不要提交到Git，不要填写到Excel。
ND_ADAPTER_MODULES=school_adapters.register

# 统一认证：若只需一个Token，可直接填字符串；OIDC通常填JSON对象。
ND_SSO_ENDPOINT=
ND_SSO_SECRET=

# 学校数据中台：可直接Token，也可JSON，例如 {"token":"...","app_id":"...","secret":"..."}
ND_MIDDLE_ENDPOINT=
ND_MIDDLE_SECRET=

# 湘培直通车：按正式规范可放 app_id / secret / token / institution_code 等。
ND_PROVINCE_ENDPOINT=
ND_PROVINCE_SECRET=

# 仅学校正式接口确实在私网时填写经过批准的主机名列表；禁止环回/链路本地地址。
ND_INTEGRATION_PRIVATE_HOSTS=

# 学校移动门户消息推送：填学校给的应用 ID（yyid）才开启，留空即关闭；需学校把服务器出口 IP 加入白名单。
ND_MESSAGE_PUSH_YYID=
# 接口地址默认用《湖科职消息中心集成标准接口文档v1.0》里的地址，一般不用改。
#ND_MESSAGE_PUSH_ENDPOINT=https://ydmh.hnkjxy.net.cn/ydmh/api/send/send
