+    assert result['details']['typed_roundtrip_verified'] and not result['disaster_restore_proven']
+    with zipfile.ZipFile(io.BytesIO(data)) as z:
+        m=json.loads(z.read('manifest.json'));assert m['format'].endswith('v2')
