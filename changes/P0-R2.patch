+class RecordUpdate(RecordIn):
+    expected_version:int=Field(ge=1)
+class QualificationIn(Reason):
+    teacher_id: Ident
+    category: str=Field(min_length=1,max_length=80)
+    name: Text
+    certificate_no: str=Field(min_length=1,max_length=128)
+    issuer: Text
+    obtained: date
