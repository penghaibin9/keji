+def test_attachment_tamper_and_symlink_blocked(client2,app2,tmp_path):
+    auth(client2,'teacher');x=qual(client2);r=upload(client2,x);assert r.status_code==200
+    ident=r.json()['id']
+    with app2.state.sessions() as db:key=db.get(Attachment,ident).storage_key
+    path=app2.state.settings.storage_dir/key;original=path.read_bytes();path.write_bytes(b'corrupt')
+    assert client2.get(f'/api/attachments/{ident}/download').status_code==503
+    path.unlink();outside=tmp_path/'outside';outside.write_bytes(original);path.symlink_to(outside)
+    assert client2.get(f'/api/attachments/{ident}/download').status_code==503
