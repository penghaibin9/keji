     reused=(task.payload or {}).get('reused_item_ids') or []
     return db.scalars(select(SyncItem).where((SyncItem.task_id==task.id)|(SyncItem.id.in_(reused))).order_by(SyncItem.created_at,SyncItem.id)).all()
